generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String?
  specialty String?
  image     String?
  bio       String?
  status    String   @default("Active")
}

model Media {
  id              Int      @id @default(autoincrement())
  name            String?
  url             String?
  type            String?
  visible_on_home Int      @default(0)
  createdAt       DateTime @default(now())
}

model Service {
  id          Int     @id @default(autoincrement())
  title       String?
  description String?
  image       String?
}

model BlogPost {
  id      Int     @id @default(autoincrement())
  slug    String  @unique
  title   String?
  excerpt String?
  content String?
  date    String?
  image   String?
  status  String  @default("Published")
}

model Testimonial {
  id      Int     @id @default(autoincrement())
  name    String?
  rating  Int?
  comment String?
  status  String  @default("Pending")
}

model Content {
  id      Int     @id @default(autoincrement())
  section String  @unique
  data    String?
}

model Appointment {
  id           Int     @id @default(autoincrement())
  patient_name String?
  email        String?
  phone        String?
  doctor_id    Int?
  service      String?
  date         String?
  time         String?
  status       String  @default("Pending")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  subject   String?
  message   String?
  createdAt DateTime @default(now())
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String?
  role     String?
  status   String  @default("Active")
}
